{
  "manifest_version": 3,
  "name": "OASIS",
  "version": "1.2.0",
  "description": "儲存分頁網址，並偵測任何網站正在播放的影片（HLS、DASH、MP4），一鍵送到 Oasis 下載。",
  "permissions": ["storage", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OASIS",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "incognito": "spanning"
}
